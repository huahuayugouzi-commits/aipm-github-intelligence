# GitHub token is optional in mock mode. A token raises the REST API rate limit.
GITHUB_TOKEN=
GITHUB_PROJECTS_PER_CATEGORY=8

# Use mock for a zero-cost local demo, or openai for an OpenAI-compatible endpoint.
DATA_MODE=mock
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# Prices per 1,000,000 tokens. Set these for the model you actually use.
AI_INPUT_PRICE=0
AI_OUTPUT_PRICE=0
AI_WEEKLY_TOKEN_BUDGET=50000
AI_DAILY_TOKEN_BUDGET=15000
AI_RUN_TOKEN_BUDGET=30000
AI_DAILY_COST_BUDGET=1
AI_WEEKLY_COST_BUDGET=5
AI_MAX_PROJECTS_PER_RUN=5
AI_MAX_INPUT_CHARS=18000
AI_MAX_OUTPUT_TOKENS=1800
AI_TIMEOUT_MS=60000

APP_TIMEZONE=Asia/Shanghai
CRON_SCHEDULE=0 9 * * 1
# Daily lightweight GitHub counters only; no README fetch and no AI call.
SNAPSHOT_CRON_SCHEDULE=30 8 * * *
PORT=3000
DATABASE_PATH=./data/aipm.db

# Required for Dashboard manual runs and external Cron. The built-in scheduler uses a separate ephemeral server-only secret.
PIPELINE_SECRET=
